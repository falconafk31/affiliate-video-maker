# Environment variables — NEVER commit these
backend/.env
frontend/.env

# Temporary processing files (auto-created by backend)
backend/temp_processing/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Node / Frontend
node_modules/
frontend/dist/
frontend/.local/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Generated media, subtitles, thumbnails, and uploaded fonts
backend/static/**
!backend/static/.gitkeep
backend/temp_processing/
backend/*.mp3
backend/*.mp4
backend/*.wav
backend/*.m4a
backend/*.aac
backend/*.ogg
backend/*.flac
backend/*.avi
backend/*.mov
backend/*.mkv
backend/*.webm
backend/*.srt
backend/*.ass

# Runtime logs and local databases
backend/logs/*
!backend/logs/.gitkeep
backend/data/
*.db
*.db-*
*.sqlite
*.sqlite3
.env
backend/static/library/*
